{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "NovelForge Editorial Studio",
  "version": "1.1.0-prototype",
  "mode": "light",
  "status": "proposal-only",
  "description": "独立 UI 原型提案，未接入生产样式。tokens 完整对应 tokens.css 的 :root 默认变量，overrides 完整对应 7 个 .program-window 属性选择器的变量；CSS 自定义属性名是稳定的导入键，color-scheme 单独由 modes 元数据说明。",
  "metadata": {
    "palettes": ["moss", "ocean", "plum", "amber"],
    "defaultPalette": "moss",
    "modePaletteIndependent": true,
    "scope": ".program-window",
    "combinationCount": 8,
    "stageMode": "light",
    "stageColorScheme": "light",
    "description": "4 种配色 moss/ocean/plum/amber × 2 种模式 light/dark，共 8 种组合。mode 与 palette 独立选择，仅作用于 program window；moss 使用默认变量及 dark 模式覆盖，无须独立配色覆盖块。外层 stage 始终为 light，不随程序窗口切换。"
  },
  "modes": {
    "light": {
      "colorScheme": "light"
    },
    "dark": {
      "colorScheme": "dark"
    }
  },
  "principles": [
    "Manuscript first, AI second",
    "Task-based navigation instead of dual activity rails",
    "Use typography and whitespace before borders or elevation",
    "Distinguish generated proposals from committed text",
    "One semantic color per intent; seven semantic stacking levels",
    "程序窗口支持独立选择 light/dark 模式与 moss/ocean/plum/amber 配色；外层 stage 始终 light，现有生产主题不受影响"
  ],
