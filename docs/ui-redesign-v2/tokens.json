{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "NovelForge UI Redesign v2 · Forge Console",
    "version": "2.0.0-review",
    "status": "design-review-only",
    "date": "2026-11-11",
    "scope": "docs/ui-redesign-v2 — standalone prototype; production app is untouched",
    "contrastNote": "All colours are CSS variables. The manuscript sheet stays light in both light and dark mode; only the surrounding workbench inverts.",
    "i18n": ["zh-CN", "en-US", "ru-RU"],
    "files": {
      "tokens": "tokens.css",
      "layout": "prototype.css",
      "components": "components.css",
      "copy": "data.js",
      "primitives": "ui.js",
      "application": "app.js"
    }
  },
  "color": {
    "semantic": {
      "shell": { "$value": "{color.mode.shell}", "$type": "color", "description": "Workbench base, behind all panels" },
      "rail": { "$value": "{color.mode.rail}", "$type": "color", "description": "48–52px activity rail" },
      "panel": { "$value": "{color.mode.panel}", "$type": "color", "description": "Context / assistant columns" },
      "surface": { "$value": "{color.mode.surface}", "$type": "color", "description": "Cards, controls, inputs" },
      "surfaceRaised": { "$value": "{color.mode.surfaceRaised}", "$type": "color", "description": "Popovers and floating layers" },
      "ink": { "$value": "{color.mode.ink}", "$type": "color", "description": "Headings and primary labels" },
      "text": { "$value": "{color.mode.text}", "$type": "color", "description": "Body UI copy" },
      "muted": { "$value": "{color.mode.muted}", "$type": "color", "description": "Secondary labels" },
      "faint": { "$value": "{color.mode.faint}", "$type": "color", "description": "Disabled / tertiary" },
      "line": { "$value": "{color.mode.line}", "$type": "color", "description": "1px structural divider" },
      "lineStrong": { "$value": "{color.mode.lineStrong}", "$type": "color", "description": "Emphasised divider and input border" },
      "grid": { "$value": "{color.mode.grid}", "$type": "color", "description": "24px structural grid, very low contrast" },
      "brand": { "$value": "{color.palette.brand}", "$type": "color", "description": "Signal / primary action — the only colour that follows the palette" },
      "brandSoft": { "$value": "{color.palette.brandSoft}", "$type": "color", "description": "Selection, active row, running task" },
      "onBrand": { "$value": "{color.palette.onBrand}", "$type": "color", "description": "Text on a filled primary button" },
      "accent": { "$value": "{color.mode.accent}", "$type": "color", "description": "Editorial notes and context references" },
      "success": { "$value": "{color.mode.success}", "$type": "color", "description": "Saved / finalised / accepted" },
      "warning": { "$value": "{color.mode.warning}", "$type": "color", "description": "Awaiting approval / unsaved" },
      "danger": { "$value": "{color.mode.danger}", "$type": "color", "description": "Error and destructive actions" },
      "info": { "$value": "{color.mode.info}", "$type": "color", "description": "References and informational states" },
      "overlay": { "$value": "{color.mode.overlay}", "$type": "color", "description": "Modal backdrop" }
    },
    "mode": {
      "light": {
        "shell": "#e9edf1", "rail": "#dde4ea", "panel": "#f4f7f9",
        "surface": "#ffffff", "surfaceRaised": "#ffffff",
        "ink": "#101a23", "text": "#354451", "muted": "#66788a", "faint": "#8b9aa8",
        "line": "#d5dee6", "lineStrong": "#b7c5d0", "grid": "#dae3ea",
        "accent": "#0b7a70", "success": "#1d8a5c", "warning": "#a76d10",
        "danger": "#bd3e49", "info": "#2b6cb0", "overlay": "#0b111a66"
      },
      "dark": {
        "shell": "#0b1117", "rail": "#0e1620", "panel": "#131c25",
        "surface": "#1a2530", "surfaceRaised": "#202d39",
        "ink": "#eef4f9", "text": "#c1ced9", "muted": "#8497a8", "faint": "#64798a",
        "line": "#26343f", "lineStrong": "#3a4c59", "grid": "#1b2833",
        "accent": "#57c9b5", "success": "#56c08a", "warning": "#e0b45a",
        "danger": "#ef7d85", "info": "#7fb6ea", "overlay": "#04080dd9"
      }
    },
    "palette": {
      "cobalt": {
        "light": { "brand": "#2f5fe0", "brandHover": "#204cbe", "brandSoft": "#e3ebff", "onBrand": "#ffffff", "selection": "#dce8ff" },
        "dark": { "brand": "#6f9bff", "brandHover": "#93b4ff", "brandSoft": "#172b4d", "onBrand": "#08142c", "selection": "#1d3c6b" }
      },
      "ember": {
        "light": { "brand": "#d1552d", "brandHover": "#ae3f1d", "brandSoft": "#fbe9e1", "onBrand": "#ffffff", "selection": "#fbe9e1" },
        "dark": { "brand": "#ff8a5c", "brandHover": "#ffab88", "brandSoft": "#42231a", "onBrand": "#2a1008", "selection": "#4a271b" }
      },
      "jade": {
        "light": { "brand": "#0f7f63", "brandHover": "#0a624c", "brandSoft": "#dff3ec", "onBrand": "#ffffff", "selection": "#dff3ec" },
        "dark": { "brand": "#4fd1a5", "brandHover": "#7fe3c2", "brandSoft": "#12382d", "onBrand": "#041c14", "selection": "#153d30" }
      },
      "orchid": {
        "light": { "brand": "#7b45c9", "brandHover": "#6233a8", "brandSoft": "#efe7fa", "onBrand": "#ffffff", "selection": "#efe7fa" },
        "dark": { "brand": "#c08cff", "brandHover": "#d2adff", "brandSoft": "#342145", "onBrand": "#1b0b2b", "selection": "#3b2650" }
      }
    },
    "manuscriptInvariant": {
      "note": "The sheet never inverts. In dark mode the light sheet is the visual focus of the whole window.",
      "light": { "paper": "#ffffff", "ink": "#18212a", "text": "#3c4954", "muted": "#87929c", "line": "#e2e8ec", "mark": "#f2f6ff" },
      "dark": { "paper": "#f7f5ef", "ink": "#18212a", "text": "#3c4954", "muted": "#87929c", "line": "#ded9cd", "mark": "#e9efff" }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": ["Segoe UI", "Inter", "Microsoft YaHei", "PingFang SC", "Noto Sans SC", "sans-serif"],
      "writing": ["Songti SC", "Noto Serif SC", "SimSun", "Georgia", "serif"],
      "mono": ["Cascadia Code", "SFMono-Regular", "Consolas", "monospace"]
    },
    "fontSize": { "xs": 10, "sm": 11, "md": 12, "base": 13, "lg": 15, "xl": 18, "writing": 17, "heading": 24, "display": 32 },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": { "tight": 1.35, "ui": 1.55, "writing": 2.05 },
    "letterSpacing": { "label": "0.12em", "writing": "0.02em" },
    "numeric": "font-variant-numeric: tabular-nums for every count, cost and progress figure"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "xs": 2, "sm": 4, "md": 6, "lg": 10, "pill": 999 },
  "layout": {
    "rail": 52, "context": 248, "assistant": 320, "runtime": 176,
    "topbar": 40, "statusbar": 26, "titlebar": 38, "manuscript": 720,
    "density": { "compact": 0.75, "normal": 1, "comfortable": 1.25 },
    "focusMode": "All rails hidden; the sheet is centred at 720px."
  },
  "zIndex": { "base": 0, "raised": 10, "sticky": 20, "dropdown": 30, "overlay": 40, "modal": 50, "toast": 60 },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "background": {
    "image": "memory-only local preview; never uploaded or persisted",
    "strength": 0.6, "blur": "0px", "fit": "cover", "position": "50% 50%",
    "gridOpacity": { "light": 0.42, "dark": 0.7 },
    "readability": "A veil plus surface-opacity tokens keep every text block legible over a custom image."
  },
  "principles": [
    "Four layers: rail (where), context (what), workspace (the work), runtime (what the AI is doing).",
    "Every real NovelForge feature keeps a discoverable home; no invented feature replaces an existing one.",
    "State is always written in words as well as colour: running, awaiting approval, unsaved, saved.",
    "AI proposals never write directly into the manuscript; review and undo stay explicit.",
    "Three-language strings for all user-visible copy; manuscript sample text is source content.",
    "Prototype data lives in page memory only; no filesystem, database, network or model calls."
  ]
}
