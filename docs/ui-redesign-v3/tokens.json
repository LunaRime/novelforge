{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Editorial Workbench",
    "version": "3.0.0-prototype",
    "status": "design-proposal-only",
    "date": "2026-11-11",
    "scope": "docs/ui-redesign-v3 独立原型提案，不用于 production，不修改生产应用。",
    "proposal": "接替 v3 半成品：以 v2 功能完整性为底盘，综合 v1 暖白阅读感与四配色；新增写作/构建双工作态、v1 编辑闭环与 v1/v2/v3 三方对照表。",
    "defaultMode": "light",
    "defaultPalette": "jade",
    "defaultPaper": "auto",
    "paperOptions": ["auto", "light"],
    "paletteLabels": { "cobalt": "海蓝", "ember": "麦金", "jade": "苔绿", "orchid": "暮紫" },
    "contrastNote": "四个 palette 在浅色和暗色的主按钮常态及 hover 态文字对比度均不低于 4.5:1。稿纸默认跟随模式；data-paper=light 可独立选择暖亮稿纸，不强制恒亮。",
    "tokenFormat": "defaultTokens 与 tokens 均为 :root 的完整 CSS 变量映射；overrides 按 CSS 选择器和声明顺序记录实际覆盖块。应用顺序为默认、模式、palette、密度、正文字号、亮稿纸。",
    "compatibility": "保留 v2 顶层分组、全部原变量名和 palette ID；color.manuscriptInvariant 为旧字段名，现表示随模式变化的稿纸而非恒亮不变量。语义别名指向浅色默认，动态取值使用 overrides。",
    "fontLoading": "NF Inter、NF Sans、NF Serif 使用本地字体，@font-face 由主助手 CSS 声明。",
    "i18n": ["zh-CN", "en-US", "ru-RU"],
    "files": {
      "tokens": "tokens.css",
      "layout": "prototype.css",
      "components": "components.css",
      "synthesisStyles": "v3.css",
      "controlStyles": "controls.css",
      "refineStyles": "refine.css",
      "settingsStyles": "settings.css",
      "dialogStyles": "dialogs.css",
      "customScrollStyles": "custom-scroll.css",
      "responsiveStyles": "responsive.css",
      "workbenchStyles": "workbench.css",
      "customScrollScript": "custom-scroll.js",
      "copy": "data.js",
      "primitives": "ui.js",
      "views": "views.js",
      "synthesisViews": "v3-views.js",
      "customControlViews": "v3-controls.js",
      "customControlRuntime": "v3-controls-runtime.js",
      "application": "app.js",
      "fonts": "fonts/"
    }
  },
  "color": {
    "semantic": {
      "shell": { "$value": "{color.mode.light.shell}", "$type": "color", "description": "工作台底层" },
      "rail": { "$value": "{color.mode.light.rail}", "$type": "color", "description": "统一侧栏表面，保留旧活动栏兼容" },
      "panel": { "$value": "{color.mode.light.panel}", "$type": "color", "description": "上下文与助手面板" },
      "surface": { "$value": "{color.mode.light.surface}", "$type": "color", "description": "卡片、控件与输入框" },
      "surfaceSoft": { "$value": "{color.mode.light.surfaceSoft}", "$type": "color", "description": "柔和次级表面" },
      "surfaceHover": { "$value": "{color.mode.light.surfaceHover}", "$type": "color", "description": "悬停表面" },
      "surfaceRaised": { "$value": "{color.mode.light.surfaceRaised}", "$type": "color", "description": "弹出与浮动表面" },
      "ink": { "$value": "{color.mode.light.ink}", "$type": "color", "description": "标题与主要标签" },
      "text": { "$value": "{color.mode.light.text}", "$type": "color", "description": "界面正文" },
      "muted": { "$value": "{color.mode.light.muted}", "$type": "color", "description": "次级标签" },
      "faint": { "$value": "{color.mode.light.faint}", "$type": "color", "description": "三级与禁用文本" },
      "line": { "$value": "{color.mode.light.line}", "$type": "color", "description": "结构分隔线" },
      "lineStrong": { "$value": "{color.mode.light.lineStrong}", "$type": "color", "description": "强调分隔与输入边框" },
      "grid": { "$value": "{color.mode.light.grid}", "$type": "color", "description": "低对比结构网格" },
      "brand": { "$value": "{color.palette.jade.light.brand}", "$type": "color", "description": "主操作颜色，默认苔绿" },
      "brandHover": { "$value": "{color.palette.jade.light.brandHover}", "$type": "color", "description": "主操作悬停颜色" },
      "brandSoft": { "$value": "{color.palette.jade.light.brandSoft}", "$type": "color", "description": "活跃行与任务柔和底色" },
      "onBrand": { "$value": "{color.palette.jade.light.onBrand}", "$type": "color", "description": "实心主按钮文字" },
      "accent": { "$value": "{color.mode.light.accent}", "$type": "color", "description": "编辑注记与上下文引用" },
      "accentSoft": { "$value": "{color.mode.light.accentSoft}", "$type": "color", "description": "编辑注记柔和底色" },
      "success": { "$value": "{color.mode.light.success}", "$type": "color", "description": "已保存、完成或接受" },
      "successSoft": { "$value": "{color.mode.light.successSoft}", "$type": "color", "description": "成功柔和底色" },
      "warning": { "$value": "{color.mode.light.warning}", "$type": "color", "description": "待批准或未保存" },
      "warningSoft": { "$value": "{color.mode.light.warningSoft}", "$type": "color", "description": "警告柔和底色" },
      "danger": { "$value": "{color.mode.light.danger}", "$type": "color", "description": "错误与破坏性操作" },
      "dangerSoft": { "$value": "{color.mode.light.dangerSoft}", "$type": "color", "description": "错误柔和底色" },
      "info": { "$value": "{color.mode.light.info}", "$type": "color", "description": "参考与信息状态" },
      "infoSoft": { "$value": "{color.mode.light.infoSoft}", "$type": "color", "description": "信息柔和底色" },
      "selection": { "$value": "{color.palette.jade.light.selection}", "$type": "color", "description": "选择态随 palette 变化" },
      "overlay": { "$value": "{color.mode.light.overlay}", "$type": "color", "description": "模态遮罩" },
      "transparent": { "$value": "{color.mode.light.transparent}", "$type": "color", "description": "透明表面" }
    },
    "mode": {
      "light": {
        "shell": "#f0f1eb", "rail": "#f6f5f1", "panel": "#f8f8f3",
        "surface": "#fffefa", "surfaceSoft": "#efeee8", "surfaceHover": "#e9e9e1", "surfaceRaised": "#fffefa",
        "ink": "#252d29", "text": "#454e47", "muted": "#6c756d", "faint": "#748070",
        "line": "#dddfd5", "lineStrong": "#c6ccbf", "grid": "#e2e5dc",
        "brand": "#405c47", "brandHover": "#304a37", "brandSoft": "#e5ecdf", "onBrand": "#ffffff",
        "accent": "#9a573f", "accentSoft": "#f4e9df", "success": "#405c47", "successSoft": "#e5ecdf",
        "warning": "#865e27", "warningSoft": "#f5eddb", "danger": "#a0443e", "dangerSoft": "#f8e8e5",
        "info": "#4e667b", "infoSoft": "#e8eef3", "selection": "#e5ecdf", "overlay": "#252d293d", "transparent": "transparent"
      },
      "dark": {
        "shell": "#191f1b", "rail": "#202721", "panel": "#222a24",
        "surface": "#2b332c", "surfaceSoft": "#303831", "surfaceHover": "#3a443b", "surfaceRaised": "#303831",
        "ink": "#edf0e8", "text": "#cbd3c8", "muted": "#a6b2a3", "faint": "#98a393",
        "line": "#3c463c", "lineStrong": "#596554", "grid": "#303a31",
        "brand": "#b4cba5", "brandHover": "#c9dcbf", "brandSoft": "#354430", "onBrand": "#1a2416",
        "accent": "#e3b096", "accentSoft": "#45372f", "success": "#a9c79c", "successSoft": "#30402c",
        "warning": "#e4c281", "warningSoft": "#403824", "danger": "#eda59d", "dangerSoft": "#4a302e",
        "info": "#a5c3dd", "infoSoft": "#2b3b49", "selection": "#354430", "overlay": "#0c100cb3", "transparent": "transparent"
      }
    },
    "palette": {
      "cobalt": {
        "light": { "brand": "#3d607f", "brandHover": "#2e4b65", "brandSoft": "#e4ecf3", "onBrand": "#ffffff", "selection": "#e4ecf3" },
        "dark": { "brand": "#a8c8e4", "brandHover": "#c1daf0", "brandSoft": "#2e4254", "onBrand": "#172837", "selection": "#2e4254" }
      },
      "ember": {
        "light": { "brand": "#8d632c", "brandHover": "#714c1d", "brandSoft": "#f2eadb", "onBrand": "#ffffff", "selection": "#f2eadb" },
        "dark": { "brand": "#e5c58c", "brandHover": "#efdab6", "brandSoft": "#483d28", "onBrand": "#302513", "selection": "#483d28" }
      },
      "jade": {
        "light": { "brand": "#405c47", "brandHover": "#304a37", "brandSoft": "#e5ecdf", "onBrand": "#ffffff", "selection": "#e5ecdf" },
        "dark": { "brand": "#b4cba5", "brandHover": "#c9dcbf", "brandSoft": "#354430", "onBrand": "#1a2416", "selection": "#354430" }
      },
      "orchid": {
        "light": { "brand": "#745484", "brandHover": "#5d416b", "brandSoft": "#eee6f2", "onBrand": "#ffffff", "selection": "#eee6f2" },
        "dark": { "brand": "#d3b9e3", "brandHover": "#e3cff0", "brandSoft": "#44354e", "onBrand": "#2b1e35", "selection": "#44354e" }
      }
    },
    "manuscriptInvariant": {
      "note": "仅保留旧字段名兼容；auto 跟随工作台，dark 默认为暗色正文，不再恒亮。lightOverride 对应文件最后的 data-paper=light 覆盖块。",
      "light": { "paper": "#fffefa", "ink": "#252d29", "text": "#39483c", "muted": "#6c756d", "line": "#dddfd5", "mark": "#e5ecdf" },
      "dark": { "paper": "#242d26", "ink": "#edf0e8", "text": "#d3dace", "muted": "#a6b2a3", "line": "#465146", "mark": "#394631" },
      "lightOverride": { "paper": "#fffefa", "ink": "#252d29", "text": "#39483c", "muted": "#6c756d", "line": "#dddfd5", "mark": "#e5ecdf" }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": ["NF Inter", "NF Sans", "Microsoft YaHei", "PingFang SC", "sans-serif"],
      "writing": ["NF Serif", "Noto Serif SC", "Songti SC", "SimSun", "serif"],
      "mono": ["Cascadia Code", "SFMono-Regular", "Consolas", "Liberation Mono", "monospace"]
    },
    "fontSize": { "xs": 11, "sm": 12, "md": 13, "base": 14, "lg": 16, "xl": 20, "writing": 18, "heading": 28, "display": 36 },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": { "tight": 1.35, "ui": 1.55, "writing": 2.15 },
    "letterSpacing": { "label": "0.12em", "writing": "0.02em" },
    "numeric": "所有计数、成本与进度数字使用 font-variant-numeric: tabular-nums"
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 16, "pill": 999 },
  "layout": {
    "nav": 264, "rail": 52, "context": 248, "assistant": 320, "runtime": 150,
    "topbar": 56, "statusbar": 32, "titlebar": 40, "manuscript": 680, "content": 1180,
    "windowHeight": 840, "windowMaxWidth": 1500, "windowRadius": 14,
    "target": 36, "targetTouch": 44,
    "density": { "compact": 0.75, "normal": 1, "comfortable": 1.25 },
    "compatibility": "nav 用于统一侧栏，主助手 CSS 合并旧 rail/context；旧变量值仍保留，不再要求两个侧栏并排。",
    "focusMode": "隐藏侧栏与运行面板，正文以 680px 居中。"
  },
  "zIndex": { "base": 0, "raised": 10, "sticky": 20, "dropdown": 30, "overlay": 40, "modal": 50, "toast": 60 },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "background": {
    "image": "仅内存中的本地预览，不上传或持久化",
    "strength": 0.6, "blur": "0px", "fit": "cover", "position": "50% 50%",
    "gridOpacity": { "light": 0.42, "dark": 0.7 },
    "surfaceOpacity": { "min": 75, "default": 88, "max": 100, "unit": "%" },
    "paperOpacity": { "default": 97, "unit": "%" },
    "veil": { "light": "#252d2900", "dark": "#191f1b1a" },
    "readability": "主助手背景控件应以 --nf-bg-surface-opacity-min 限制最低 75%；默认表层 88%、稿纸 97%，配合遮罩与各模式文字色保持可读。"
  },
  "refinement": {
    "scrollbar": {
      "sizes": { "panel": "7px", "workspace": "10px", "manuscript": "12px" },
      "track": "color-mix(panel 68% + line)",
      "thumb": "color-mix(muted 42% + surface), 2px transparent inset border, pill radius",
      "states": "hover -> brand 58%, active -> brand 82%; compose mode recedes until hover; wallpaper mode raises opacity",
      "standards": "native bars hidden with scrollbar-width:none and ::-webkit-scrollbar{display:none}; every visible bar is a DOM element drawn in custom-scroll.css and driven by custom-scroll.js; scrollbar-gutter stable, overscroll-behavior contain",
      "progress": "manuscript top rule width = --nf-scroll-progress (0..1), updated on capture-phase scroll"
    },
    "typography": {
      "iconScale": { "inline": "14px", "control": "16px", "leading": "18px", "tab": "13px" },
      "gap": { "default": "6px", "tight": "5px" },
      "alignment": "icons optically nudged +0.5px; small icons use a thicker 1.85 stroke; numeric columns right-aligned with tabular-nums"
    },
    "iconography": {
      "rule": "one shape per action; undo/redo, confirm/finalise, rebuild/import/export and each settings section have dedicated glyphs",
      "semanticTones": "rail views and tree groups tinted with brand/info/accent/success/warning without replacing status colours",
      "map": "NF.V3.iconGroups renders a six-group identification table on the review stage"
    },
    "settings": {
      "layout": "236px grouped navigation + section dashboard; both columns scroll independently",
      "navigation": "10 real sections grouped into AI & models / editing & extensions / system & maintenance, with icon, name, hint and instant client-side filtering",
      "content": "section header with large glyph and state badges, four summary metrics, two-column card grid with core and advanced option groups",
      "controls": "custom switches and editable value capsules; clicking a value opens a memory-only edit dialog; tiered model routing is selectable",
      "scrollbar": "DOM-drawn track and thumb with bookmark ticks, layered highlight, hover glow, drag/keyboard support and a live percent readout; per-region tone"
    }
  },
  "principles": [
    "Editorial Workbench：v2 功能完整性结合 v1 暖白阅读感，统一侧栏、工作区与运行状态层各司其职。",
    "每项真实 NovelForge 功能都有可发现入口，不以虚构功能取代既有能力。",
    "浅色默认、jade 苔绿默认；cobalt 海蓝、ember 麦金、orchid 暮紫保留原 ID。",
    "暗色工作台默认暗色正文；稿纸 auto 跟随模式，light 为独立暖亮选项。",
    "状态始终同时使用文字和颜色表达：运行中、待批准、未保存、已保存。",
    "AI 提案不直接写入正文；审阅与撤销保持明确。",
    "所有用户可见界面文案保留三语言支持，示例正文属于源内容。",
    "原型数据仅存在于页面内存，不触发文件系统、数据库、网络或模型调用。",
    "一个工作台、两种状态：写作态收起项目树与运行层并放宽稿纸，构建态开放全部面板；切换前捕获草稿，同一份内存数据不丢失。",
    "接回 v1 编辑纪律：逐条审阅决策、只替换匹配原句、恢复前内存备份与取回、确认编辑、定稿章节只读。",
    "评审页保留 v1/v2/v3 三方对照与「真实功能 → v3 落点」矩阵；后台能力不编造界面。",
    "所有可见控件均为自绘：下拉、滑杆、开关、进度、折叠与菜单不使用原生 select / range / checkbox / progress / details 外观；键盘、焦点与 Esc 由原型统一实现。",
    "交互动画与画面表现：View Transitions 切换、@starting-style 弹层入场、列表 stagger、hover 微动、首字下沉与稿纸纹理；提供减少动效开关并遵循 prefers-reduced-motion。",
    "本轮优化新增可拖拽/键盘调宽的面板分隔条、主题预设与模型直选、v3 命令分组、实时字数与确认编辑禁用态。",
    "滚动条按 v3 画风重绘：分区宽度、语义轨道与滑块、hover/active 反馈、Firefox 标准属性兜底、写作态隐退与稿纸滚动进度线。",
    "图标与文字建立统一尺寸槽/间距/光学对齐，数值列右对齐；功能图标一动作一形状并按分组上语义色，评审页附功能图标识别表。",
    "设置面板重排为分组导航 + 分区仪表盘 + 卡片网格：10 个真实分区按语义分 3 组、即时筛选、摘要指标、自绘开关与可编辑值胶囊、分层模型路由可点选；值改动只写页面内存。",
    "滚动条在语义令牌基础上叠加高光、书页切口纹理、内嵌细线与 hover 发光，滚动时短暂增强；设置与稿纸区域各有配色，Firefox 兜底仍与 WebKit 自绘隔离。",
    "滚动条改为完全 DOM 自绘：隐藏原生条，轨道/滑块为普通元素，支持拖拽、点击轨道跳转、键盘、进度百分比与分区配色；动态重建的容器由 MutationObserver 自动注册，弹层内的条挂在该 dialog 层。",
    "设置观感继续升级：按分组上 brand/accent/info 主题色，卡片色带与 stagger、行语义图标、开关状态文字、头部水印、摘要迷你进度、搜索快捷键与清除、便签式说明、两行值胶囊；命令面板/外观面板/统计弹窗画风统一。",
    "设置分区切换改为局部更新：只替换右栏与导航 active 类，不重建 dialog；入场动画改为无透明度位移且局部更新时禁用，消除点击闪白；开关与模型路由改为轻量 DOM 更新。",
    "移除设置导航的计数徽标与箭头；任务状态徽章与操作按钮统一到同一右侧容器并垂直居中；语言按钮用 globe + 文字、主题按钮用半填充圆纯图标以区分；toast、下拉、外观面板、选区气泡与 dialog 等悬浮层统一圆角与双层阴影。",
    "面板头部与稿纸页脚的尾部控件改为成组靠右（context-actions / sheet-foot-right），避免 space-between 把中间元素顶到正中；项目树头部改用干净的刷新图标，重建索引/重建记忆/运行层折叠的文案与图标语义对齐。",
    "停用 View Transitions 与稿纸透明度入场动画：切到其他标签时旧稿纸快照会残留在 top layer，改为同步更新 + 无透明度的位移入场与稿纸宽度过渡，并立即刷新自绘滚动条。",
    "自绘滚动条描边减弱但保留层次：常态 42% 透明、hover 68%、拖拽 82%，去掉多余内描边环，轨道细线降至 42%。",
    "自绘滚动条布局同步：每个滚动容器单独 ResizeObserver、MutationObserver 监听 class/style/data-* 属性、200ms 几何哨兵比对 rect 签名、容器跨 dialog 层时重挂、点击与拖拽分隔条后主动 refresh；坐标与滑块高度做限幅，过矮过窄或无垂直溢出时隐藏。",
    "窄尺寸容器约束：整条 flex/grid 链补 min-width:0 与 overflow-x:hidden，单行标签省略、描述文案 overflow-wrap:anywhere，并在 1000/760/560px 容器断点降低密度与字号，避免字体溢出与横向滚动异常。",
    "消除文本与浮层的叠压：去掉卡片右上角绝对定位的序号（它压住了行计数徽标与头部文案），设置行标签与值胶囊按 58%/54% 分配宽度且各自可省略并带 title 全文；头部水印与便签折角退到文字之后；搜索框移除未绑定快捷键的「/」提示，并将 type=search 改为 type=text 以消除浏览器自带的第二个清除按钮，只保留一个随筛选状态显隐的自绘清除按钮。",
    "检索总览表头与数据行共用 --kb-cols 列定义，数字列表头也右对齐并使用 tabular-nums，窄容器另有紧凑列宽。",
    "运行层新增竖向分隔条：作为 .workspace 的子元素（避免 renderRuntime 重建时丢失），拖拽、Up/Down/Home/End、双击复位，96–420px 限幅并同步 aria 数值与自绘滚动条。",
    "短信息类弹窗（快捷键、开发控制台、版本、引用与通用 info）改为锚定触发器的列表弹层：复用 dialog 顶层容器与 Esc/取消逻辑，透明背景、点击空白关闭、列表项错峰入场，表单与确认类弹窗保持居中对话框。",
    "用量统计加入一眼可读的图形：统计卡支持语义图标/趋势/迷你条，设置「用量统计」分区新增用量仪表盘（4 项带图标指标、12 日柱形趋势、缓存命中环形图、模型分布色点），全部由语义令牌取色。",
    "滚轮（鼠标中键）修复：根因是装饰性裁切使用 overflow:hidden，而 hidden 仍会创建滚动容器（只是不画滚动条），滚轮落在卡片、分区头部、弹层外框时会被它们吞掉；responsive.css 的 overflow-x:hidden 更隐蔽，会让未声明 overflow-y 的元素被计算成 auto，凭空多出一批滚动容器。修法：窗口/工作区/卡片/分区头部/弹层外框等大块装饰裁切改为 overflow:clip（裁切但不创建滚动容器），responsive.css 改用 overflow-x:clip；单行省略号标签因 text-overflow:ellipsis 需要保留 overflow:hidden，它们垂直不溢出且由滚轮路由兜底。custom-scroll.js 增加捕获阶段 wheel 路由：指针落在弹层头尾、自绘滚动条、窗口工具栏或残留幽灵容器上时把滚轮送到该面板自己的滚动容器；容器内无障碍时仍交由浏览器原生滚动，Ctrl+滚轮缩放、deltaMode 换算、边界限幅与嵌套滚动均保持。原生条隐藏列表补上 .lp-rows，避免列表弹层同时出现原生条与自绘条。"
  ],
