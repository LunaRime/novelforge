  "cards": [
    {
      "dot": "rose",
      "title": "三处结构性缺口",
      "items": [
        "双轨：agent 与 workflow 都能写章节，进度/撤销/失败恢复不一致",
        "越界：工具直接改 UI，agent 无法脱离 Electron 单测",
        "分散：正文 / 元数据 / 文件 / 大纲 / 记忆 / 向量各存一份"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么改不动",
      "items": [
        "draft-index 用 vela:// URI 充当文件路径",
        "chapter_number 当主键，与 blueprints 无硬外键",
        "一致性靠定稿后 8 路 DAG 事后补偿"
      ]
    }
  ]
